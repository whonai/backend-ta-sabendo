{
  "name": "ta-rolando-feira-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "import:osm-venues": "ts-node --transpile-only src/scripts/importOsmVenues.ts",
    "sync:curated": "ts-node --transpile-only src/scripts/syncCuratedCatalog.ts",
    "collect:instagram": "ts-node --transpile-only src/scripts/runInstagramCollector.ts",
    "register:instagram-profile": "ts-node --transpile-only src/scripts/registerMonitoredInstagramProfile.ts",
    "purge:events": "ts-node --transpile-only src/scripts/purgeLegacyEvents.ts",
    "purge:ephemeral": "ts-node --transpile-only src/scripts/purgeEphemeralEvents.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "google-auth-library": "^9.15.1",
    "mongoose": "^7.6.0",
    "tesseract.js": "^5.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
