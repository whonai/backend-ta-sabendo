PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/ta_rolando
MONGODB_DB=ta_rolando
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Catálogo demo só se pedir explicitamente (não re-popula eventos no boot):
# SEED_FORCE=true
# SEED_ON_EMPTY=true
# SYNC_CURATED_ON_BOOT=true
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_BBOX_SOUTH=-12.32
# OSM_BBOX_WEST=-39.02
# OSM_BBOX_NORTH=-12.19
# OSM_BBOX_EAST=-38.90

# --- Pipeline Instagram (MVP) ---
# ENABLE_INSTAGRAM_COLLECTOR=true
# INSTAGRAM_COLLECTION_INTERVAL_MINUTES=120
# Padrão: instagrapi (use INSTAGRAM_ADAPTER=mock só em dev isolado)
INSTAGRAM_ADAPTER=instagrapi
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=
# Ou cookie sessionid do navegador (instagram.com → DevTools → Application → Cookies):
# INSTAGRAM_SESSIONID=
# INSTAGRAM_SESSION_PATH=./data/instagram-session.json
# INSTAGRAM_MEDIA_DIR=./data/instagram-media
# INSTAGRAM_DELETE_MEDIA_AFTER_OCR=false
# EVENT_EXTRACTION_MIN_CONFIDENCE=0.55
# INSTAGRAM_DISCOVER_DELAY_MS=2500

# Parte 3 — coleta diária automática (1440 = 1x/dia)
# ENABLE_INSTAGRAM_COLLECTOR=true
# INSTAGRAM_COLLECTION_INTERVAL_MINUTES=1440
